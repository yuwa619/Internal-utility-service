# =============================================================================
# .env.example — Environment Variable Template
#
# Copy this file to .env and fill in the real values.
#   cp .env.example .env
#
# .env is listed in .gitignore and must NEVER be committed.
# In production (EC2), secrets are fetched from AWS Secrets Manager at
# runtime; these env vars are used as fallbacks for local development only.
# =============================================================================

# Application
ENVIRONMENT=development          # development | production

# Database (local dev fallback — production reads from AWS Secrets Manager)
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=internal_db

# AWS Secrets Manager (leave blank for local dev without AWS)
# When set, the app fetches DB_* values from this secret at startup.
AWS_SECRETS_MANAGER_SECRET_NAME=
AWS_REGION=us-east-1

# Flask (never set to "true" in production)
FLASK_DEBUG=false
